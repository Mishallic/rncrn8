+"""SQLite storage for customers and invoices."""
+
+import sqlite3
+
+
+def connect(path: str = "invoicing.db") -> sqlite3.Connection:
+    conn = sqlite3.connect(path)
+    conn.row_factory = sqlite3.Row
+    conn.execute("CREATE TABLE IF NOT EXISTS customers (id INTEGER PRIMARY KEY, name TEXT, email TEXT)")
+    conn.execute(
+        "CREATE TABLE IF NOT EXISTS invoices (id INTEGER PRIMARY KEY, customer_id INTEGER, total REAL, sent INTEGER DEFAULT 0)"
+    )
+    return conn
+
+
+def add_customer(conn: sqlite3.Connection, name: str, email: str) -> int:
+    cur = conn.execute("INSERT INTO customers (name, email) VALUES (?, ?)", (name, email))
+    conn.commit()
+    return cur.lastrowid
